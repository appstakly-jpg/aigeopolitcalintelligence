# Copy to .env (or run ./scripts/init-env.sh, which generates the secrets) and fill in.
# Never commit .env. Every integration below is optional: without its credentials the platform says
# so in the UI and falls back to deterministic, rule-based processing; nothing is faked.

# ---------------------------------------------------------------- required secrets
# Postgres password for the bundled database (docker-compose.yml builds DATABASE_URL from it).
POSTGRES_PASSWORD=
# Signs session cookies. At least 32 random characters: openssl rand -hex 32
SESSION_SECRET=
# AES-256-GCM key for tenant secrets (Slack/Telegram/webhook credentials) and MFA seeds.
# 32 random bytes, base64: openssl rand -base64 32. Rotating it makes stored secrets unreadable.
APP_ENCRYPTION_KEY=

# ---------------------------------------------------------------- web
# Public URL of the web app (used in alert and report links).
APP_BASE_URL=http://localhost:3000
# Secure cookies need HTTPS. Set false only for plain-http testing on a private machine.
SECURE_COOKIES=true
# Interface and port the web container is published on (127.0.0.1 = this machine only).
WEB_BIND=127.0.0.1
WEB_PORT=3000
# local = email/password + TOTP MFA (built in). supabase = Supabase Auth JWTs (set SUPABASE_JWT_SECRET).
AUTH_PROVIDER=local
SUPABASE_JWT_SECRET=
# test = plan changes are free and immediate (no payment processor). Prices live in the plans table.
BILLING_MODE=test
# Optional vector-tile style URL for the map (build-time). Empty = bundled offline country basemap.
NEXT_PUBLIC_MAP_STYLE_URL=
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------- demo mode
# true = allow the clearly labelled SYNTHETIC demo organisation (docker compose --profile demo).
# Keep false in production.
DEMO_MODE=false
# Password for the four demo users (admin/analyst/reviewer/client@demo.example).
DEMO_PASSWORD=
# Seconds before the demo feeds release stage 2 (denials, corrections, follow-ups).
DEMO_STAGE2_AFTER_SECONDS=600
# The demo feed server runs on the private Docker network, so the demo needs this. Keep false in
# production: it is the guard against fetching internal addresses (SSRF).
ALLOW_PRIVATE_NETWORK_FETCH=false

# ---------------------------------------------------------------- AI models (optional)
# Without a key: rule-based extraction, no machine translation (marked as such), extractive
# AI-analyst answers. Provider is auto-detected from the key unless LLM_PROVIDER is set
# (anthropic | openai | gemini | none).
ANTHROPIC_API_KEY=
# Explicit endpoint for the Anthropic API (an ambient ANTHROPIC_BASE_URL is deliberately ignored).
LLM_ANTHROPIC_BASE_URL=
LLM_PROVIDER=
# Worker model (default claude-opus-5-5 for Anthropic). LLM_MODEL_CHAT overrides the AI analyst model.
LLM_MODEL=
LLM_MODEL_CHAT=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Hard daily spend cap per organisation (USD), shared by workers and the AI analyst. Each organisation
# also has a monthly budget, set by its admins under Administration -> Policies (default 25; 0 = no model use).
LLM_DAILY_BUDGET_USD=10
LLM_MAX_CALLS_PER_RUN=200

# ---------------------------------------------------------------- notifications (optional)
# Email alerts. Without SMTP_HOST, email deliveries are logged as "not configured", never as sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com
SMTP_STARTTLS=true
# Platform Telegram bot (organisations can also store their own bot token and Slack webhook in Settings).
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------- workers
HTTP_USER_AGENT="GCCIntelBot/0.1 (+https://your-domain.example/bot; respects robots.txt)"
SCHEDULER_INTERVAL_SECONDS=60
LOG_LEVEL=INFO
# PDF export needs Chromium in the worker image: WORKER_EXTRAS=llm,pdf, WORKER_WITH_CHROMIUM=true,
# then PDF_EXPORT_ENABLED=true. HTML and DOCX export always work.
PDF_EXPORT_ENABLED=false
WORKER_EXTRAS=llm
WORKER_WITH_CHROMIUM=false
